RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ReadWritePaths=/home/nanoclaw/ooda-composite-lab
ExecStart=/usr/bin/python3 /home/nanoclaw/ooda-composite-lab-release-20261116/composite_lab.py outcomes --config /home/nanoclaw/ooda-composite-lab-release-20261116/config.json
