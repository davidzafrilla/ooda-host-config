[Unit]
Description=OODA TO-BE — price-export-shadow-monday
# B4 (en SOMBRA): comparación de la pasada del lunes 08:00 (tras su plazo, 08:30).

[Service]
Type=oneshot
WorkingDirectory=/home/nanoclaw/ooda-tobe
EnvironmentFile=/home/nanoclaw/ooda-tobe/.env
ExecStart=/home/nanoclaw/ooda-tobe/venv/bin/python /home/nanoclaw/ooda-tobe/scripts/price_export_shadow_compare.py
StandardOutput=append:/home/nanoclaw/ooda-tobe/logs/price-export-shadow-monday.log
StandardError=append:/home/nanoclaw/ooda-tobe/logs/price-export-shadow-monday.log
TimeoutStartSec=1800
SuccessExitStatus=3 75
