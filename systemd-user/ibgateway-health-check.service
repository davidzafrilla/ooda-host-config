[Unit]
Description=IB Gateway Health Check and Auto-Recovery
# 28-oct-2026 (BUG-20261027-006): Wants y no Requires. Con Requires, el «systemctl restart ibgateway»
# que lanza este mismo check propagaba el restart al check: lo mataba (rc 137, TERM) y lo relanzaba,
# y el nuevo volvía a matar el gateway que arrancaba; bucle de 2 min hasta el StartLimit (00:18-00:20).
Wants=ibgateway.service
After=ibgateway.service

[Service]
Type=oneshot
ExecStart=/home/nanoclaw/ibkr/ibkr_health_check.sh
StandardOutput=journal
StandardError=journal
