[Unit]
Description=H-028 independent LYXIB shadow; private data, no orders or messages

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2/data/h028-lyxib-runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
Nice=10
ExecStart=/usr/bin/python3 %h/nanoclaw-v2/data/h028-lyxib-runtime/scripts/h028_lyxib_shadow.py --spec %h/nanoclaw-v2/data/h028-lyxib-runtime/reports/preregistro-H028-LYXIB-20261026.spec.json --calendar %h/nanoclaw-v2/data/h028-lyxib-runtime/config/calendar_2026.json --state-dir %h/nanoclaw-v2/data/h028-lyxib-shadow --paper-db %h/nanoclaw-v2/groups/telegram_inversiones/data/paper/paper_execution.db --paper-view %h/nanoclaw-v2/groups/telegram_inversiones/data/paper/paper_portfolio.json --env-file %h/ooda-tobe/.env --spy-ledger %h/nanoclaw-v2/data/h028-shadow-benchmarks/ledger.sqlite3 --dividend-events %h/nanoclaw-v2/data/h028-lyxib-runtime/config/dividend_events.json
