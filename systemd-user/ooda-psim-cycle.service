[Unit]
Description=OODA — ciclo de los libros paper SIMULADOS PSIM-001 (1-oct-2026): gestor por libro (y 03/18/33/48) + sync + guardias + decisiones → fills simulados a bid/ask de realtime.json + NAV/vista por libro. Nunca toca IBKR ni LIVE.
OnFailure=ooda-onfailure@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2/groups/telegram_inversiones/scripts
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=-%h/nanoclaw-v2/scripts/ops/record_run.sh start %n
ExecStart=/usr/bin/python3 -P %h/nanoclaw-v2/groups/telegram_inversiones/scripts/broker/__main__.py psim cycle --all
ExecStopPost=-%h/nanoclaw-v2/scripts/ops/record_run.sh end %n
Environment=OODA_RUN_LOG=%h/nanoclaw-v2/groups/telegram_inversiones/logs/psim_cycle.log
StandardOutput=append:%h/nanoclaw-v2/groups/telegram_inversiones/logs/psim_cycle.log
StandardError=append:%h/nanoclaw-v2/groups/telegram_inversiones/logs/psim_cycle.log
SuccessExitStatus=3
TimeoutStartSec=280
Nice=15
