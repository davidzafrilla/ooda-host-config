[Unit]
Description=IB Gateway REAL read-only (Interactive Brokers, API 4001)
After=xvfb.service xfwm4.service
Requires=xvfb.service xfwm4.service

[Service]
Type=simple
Environment=DISPLAY=:99
# Credentials read by IBC from config-real.ini (chmod 600), not passed via argv.
# --on2fatimeout=exit: live account needs IB Key 2FA; IBC re-prompts the phone
# until approved instead of dying (paper unit uses exit because paper has no 2FA).
ExecStart=/bin/bash /home/nanoclaw/ibkr/ibc/scripts/ibcstart.sh 10.45 --gateway --tws-path=/home/nanoclaw/ibkr/Jts --tws-settings-path=/home/nanoclaw/ibkr/settings-real --ibc-path=/home/nanoclaw/ibkr/ibc --ibc-ini=/home/nanoclaw/ibkr/ibc/config-real.ini --mode=live --on2fatimeout=exit
EnvironmentFile=/home/nanoclaw/ibkr/env
KillMode=control-group
TimeoutStopSec=20
Restart=no
RestartSec=60

[Install]
WantedBy=default.target
