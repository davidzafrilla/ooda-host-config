[Unit]
Description=H-028 informative SPY shadow reading; private data, no broker orders or messages

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2/data/h028-shadow-runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
Nice=10
ExecStart=/usr/bin/python3 %h/nanoclaw-v2/data/h028-shadow-runtime/scripts/h028_shadow_reading.py --spec %h/nanoclaw-v2/data/h028-shadow-runtime/reports/preregistro-H028-comparadores-sombra-20261026.spec.json --calendar %h/nanoclaw-v2/data/h028-shadow-runtime/config/h028_shadow_calendar.json --state-dir %h/nanoclaw-v2/data/h028-shadow-benchmarks --cost-db %h/nanoclaw-v2/data/llm_usage.db --reading 6m
ExecStart=/usr/bin/python3 %h/nanoclaw-v2/data/h028-shadow-runtime/scripts/h028_shadow_reading.py --spec %h/nanoclaw-v2/data/h028-shadow-runtime/reports/preregistro-H028-comparadores-sombra-20261026.spec.json --calendar %h/nanoclaw-v2/data/h028-shadow-runtime/config/h028_shadow_calendar.json --state-dir %h/nanoclaw-v2/data/h028-shadow-benchmarks --cost-db %h/nanoclaw-v2/data/llm_usage.db --reading 12m
