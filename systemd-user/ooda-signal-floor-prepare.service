[Unit]
Description=Signal-floor review preparation; evidence and review queue, no certification

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Nice=10
TimeoutStartSec=600
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 %h/nanoclaw-v2/scripts/ops/signal_floor_prepare_reviews.py --runtime %h/nanoclaw-v2/data/signal-floor-followup-runtime --archive %h/nanoclaw-v2/data/signal-floor-followup/archive --state-dir %h/nanoclaw-v2/data/signal-floor-followup/state --env-file %h/ooda-tobe/.env
StandardOutput=append:%h/nanoclaw-v2/logs/ops/ooda-signal-floor-prepare.log
StandardError=append:%h/nanoclaw-v2/logs/ops/ooda-signal-floor-prepare.log
