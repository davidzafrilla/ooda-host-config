[Unit]
Description=OODA — evaluador PSIM-001 (1-oct-2026): salud diaria de los libros simulados (reports/psim/summary.md) y, en las fechas de lectura (13-abr-2027 y 13-oct-2027), contrastes por factor + DM a David. Sin cifras de efectos antes de la lectura.
OnFailure=ooda-onfailure@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=-%h/nanoclaw-v2/scripts/ops/record_run.sh start %n
ExecStart=/usr/bin/python3 -P %h/nanoclaw-v2/scripts/psim_factor_eval.py --root %h/nanoclaw-v2 --cron
ExecStopPost=-%h/nanoclaw-v2/scripts/ops/record_run.sh end %n
Environment=OODA_RUN_LOG=%h/nanoclaw-v2/groups/telegram_inversiones/logs/psim_eval.log
StandardOutput=append:%h/nanoclaw-v2/groups/telegram_inversiones/logs/psim_eval.log
StandardError=append:%h/nanoclaw-v2/groups/telegram_inversiones/logs/psim_eval.log
SuccessExitStatus=3
TimeoutStartSec=600
Nice=15
