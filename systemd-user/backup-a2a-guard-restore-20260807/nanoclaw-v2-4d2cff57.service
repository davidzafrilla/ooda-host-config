[Unit]
Description=NanoClaw TO-BE Isolated Instance
After=network.target

[Service]
Environment=A2A_MAX_CHAIN=999999
Environment=A2A_RATE_MAX=999999
Environment=A2A_MAX_PER_DAY=999999
Environment=A2A_CHAIN_DIVERSE_MAX=999999
Type=simple
ExecStart=/usr/bin/node /home/nanoclaw/nanoclaw-tobe/dist/index.js
WorkingDirectory=/home/nanoclaw/nanoclaw-tobe
Restart=always
RestartSec=5
KillMode=process
Environment=HOME=/home/nanoclaw
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/nanoclaw/.local/bin
Environment=OODA_PORT=3100
Environment=OODA_HOST=127.0.0.1
Environment=WEBHOOK_PORT=3101
StandardOutput=append:/home/nanoclaw/nanoclaw-tobe/logs/nanoclaw.log
StandardError=append:/home/nanoclaw/nanoclaw-tobe/logs/nanoclaw.error.log

[Install]
WantedBy=default.target
