[Unit]
Description=Prospective paired options rankings; observation only

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2/data/options-shadow-runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Nice=10
TimeoutStartSec=120
ExecStart=/usr/bin/python3 %h/nanoclaw-v2/data/options-shadow-runtime/options_shadow_observer.py --spec %h/nanoclaw-v2/data/options-shadow-runtime/spec.json --quality-history %h/nanoclaw-v2/groups/telegram_inversiones/data/run_quality_history.jsonl --snapshots %h/nanoclaw-v2/groups/telegram_inversiones/data/quant_signals_snapshots --state-dir %h/nanoclaw-v2/data/options-shadow
