[Unit]
Description=Publish released study views and operational status; no simulation or orders

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2/data/signal-floor-followup-runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Nice=10
TimeoutStartSec=600
ExecStart=/usr/bin/python3 %h/nanoclaw-v2/data/signal-floor-followup-runtime/scripts/publish_signal_floor_studies.py --config %h/nanoclaw-v2/data/signal-floor-followup-runtime/config/catalog_sources.json --output %h/nanoclaw-v2/groups/telegram_inversiones/data/study_catalog

