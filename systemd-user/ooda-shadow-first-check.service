[Unit]
OnFailure=ooda-onfailure@%N.service
Description=One-time metadata verification of prospective shadow startup; no orders or performance reading

[Service]
Type=oneshot
WorkingDirectory=%h/nanoclaw-v2/data/shadow-first-check-runtime
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=120
Nice=10
ExecStart=/usr/bin/python3 %h/nanoclaw-v2/data/shadow-first-check-runtime/check_shadow_first_captures.py --root %h/nanoclaw-v2 --expected-date 2026-10-26
StandardOutput=append:%h/nanoclaw-v2/data/shadow-first-check/20261026.jsonl
StandardError=journal
