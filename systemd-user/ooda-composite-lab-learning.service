[Unit]
OnFailure=ooda-onfailure@%N.service
After=ooda-composite-lab-outcomes.service
Description=OODA composite laboratory - publish evidence to existing reviewers

[Service]
ExecStartPre=-/home/nanoclaw/nanoclaw-v2/scripts/ops/record_run.sh start %n
ExecStopPost=-/home/nanoclaw/nanoclaw-v2/scripts/ops/record_run.sh end %n
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
Nice=10
CPUQuota=10%
MemoryMax=128M
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
ExecStart=/usr/bin/python3 /home/nanoclaw/ooda-composite-lab-release-20261116/composite_lab_publish_learning.py --config /home/nanoclaw/ooda-composite-lab-release-20261116/config.json
