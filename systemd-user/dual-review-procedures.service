[Unit]
Description=dual-review: revisa los procedimientos aprendidos que quedaron pendientes (revisor sin memoria o ocupado)

[Service]
Type=oneshot
WorkingDirectory=%h
ExecStart=%h/.local/share/dual-review/venv/bin/python -m dual_review.procedures --pending
# una pasada dura como mucho WORKER_BUDGET (1200 s) más la última revisión en curso
TimeoutStartSec=1800
UMask=0077
Nice=10
