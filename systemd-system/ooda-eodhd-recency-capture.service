[Unit]
Description=Cualificación EODHD_RECENCY para estudios: captura cruda bajo el recolector de recibos
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ooda-receipts
Group=ooda-receipts
ExecStart=/usr/bin/python3 -I /srv/ooda-receipts/bin/run_receipts.py run --store /srv/ooda-receipts/store --study-id eodhd-recency-estudios --study-uid 9702 --code /srv/ooda-study/eodhd_recency_estudios/code --config /srv/ooda-study/eodhd_recency_estudios/universe.json --outputs /srv/ooda-study/eodhd_recency_estudios/out --declared last-run.json --timeout 1800 -- /usr/bin/python3 -I /srv/ooda-study/eodhd_recency_estudios/code/capture.py --universe /srv/ooda-study/eodhd_recency_estudios/universe.json --out /srv/ooda-study/eodhd_recency_estudios/out --key-file /etc/ooda-study/eodhd.key --declared last-run.json
# systemd mata todo el cgroup, también el estudio bajo sudo, que el recolector sin root no puede matar.
KillMode=control-group
TimeoutStartSec=2400
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
